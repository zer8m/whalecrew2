{
  "manifest_version": 3,
  "name": "앗!차차 - 마감 일정 캘린더",
  "short_name": "앗!차차",
  "version": "1.0.7",
  "description": "충남대 학과 공지와 웹에서 드래그한 공고의 마감일을 사이드바 달력에 모아 알림으로 챙겨줍니다.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "sidebar_action": {
    "default_page": "sidebar.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "앗!차차",
    "use_navigation_bar": false
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://zer8m.github.io/*"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["chacha.png"], "matches": ["<all_urls>"] }
  ]
}
